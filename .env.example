# ============================================================================
# Kabura Tiling Group — environment variables
#
# Copy to `.env.local` for development. Set the same values in your hosting
# provider (Vercel → Settings → Environment Variables) for production.
# Everything prefixed NEXT_PUBLIC_ is bundled into the browser build;
# everything else stays server-side.
# ============================================================================

# ---------------------------------------------------------------- site ------
# Canonical origin, no trailing slash. Used for canonical URLs, OpenGraph,
# sitemap.xml and robots.txt. Set this to your real address in production —
# it is what Google reads and what appears when someone shares a link.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------ supabase ------
# Project Settings → Data API. Without these the marketing site still works
# fully; the quote form explains it is not connected and /admin is disabled.
NEXT_PUBLIC_SUPABASE_URL="https://dovgxtnxnscbizcxhncm.supabase.co"

# The publishable/anon key. Safe in the browser — every table is protected by
# row level security (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 🔒 SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste
# into a chat or an email. Settings → API → service_role → Reveal.
# Without it enquiries are still captured through the anon key, but customer
# photo uploads are skipped and the /admin dashboard stays switched off.
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------ business ------
# Phone, email and ABN have committed defaults in src/lib/site.ts, supplied by
# Kabura on 18 Aug 2026. Set these ONLY to override them — on a staging site,
# for example, or if a detail changes and you want it live before a code push.
NEXT_PUBLIC_BUSINESS_PHONE=""
NEXT_PUBLIC_BUSINESS_EMAIL=""
NEXT_PUBLIC_BUSINESS_ABN=""

# ⚠️ Still to be supplied by Kabura. Blank is safe: the site renders a clearly
# marked "to be supplied" placeholder rather than inventing anything.

# Optional street address. Omit entirely if there is no public shopfront.
NEXT_PUBLIC_BUSINESS_STREET=""
NEXT_PUBLIC_BUSINESS_SUBURB=""
NEXT_PUBLIC_BUSINESS_POSTCODE=""

# Free-text opening hours, e.g. "Mon–Fri 7am–5pm, Sat by appointment".
NEXT_PUBLIC_BUSINESS_HOURS=""

# ------------------------------------------------------- google reviews -----
# Pulls Kabura's REAL reviews from their Google Business Profile. No review is
# ever written by hand — with these unset the site says "reviews coming soon".
#
#   1. Google Cloud console → enable "Places API (New)" → create an API key
#      and restrict it to that API.
#   2. Find the Place ID for the business:
#      https://developers.google.com/maps/documentation/places/web-service/place-id
#
# 🔒 Server only — no NEXT_PUBLIC_ prefix, so the key never reaches the browser.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# -------------------------------------------------------------- social ------
# Instagram, Facebook, TikTok, YouTube and Google Business are already live:
# Kabura supplied the real URLs and they are committed in src/lib/site.ts, so
# nothing needs setting here for those five to appear.
#
# Set a variable below ONLY to override the committed URL — on a staging site,
# or if a profile moves and you want it live before a code push. Blank means
# "use the committed default", not "hide the button".
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_TIKTOK=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
# Google Business Profile URL — also used for the "leave a review" link.
NEXT_PUBLIC_SOCIAL_GOOGLE=""

# ⚠️ LinkedIn has no default. It is wired up and stays hidden — no dead icon —
# until a real URL is supplied here.
NEXT_PUBLIC_SOCIAL_LINKEDIN=""

# ---------------------------------------------------------------- misc ------
# Verification token for Google Search Console. Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
